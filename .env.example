WORKER_NAME=Mithril Worker Alpha
WORKER_VERSION=0.1.0
DEBUG=false
WORKER_HOST=0.0.0.0
WORKER_PORT=8001
WORKER_BASE_URL=http://localhost:8001
HEALTH_ENDPOINT=/health
ORCHESTRATOR_URL=http://localhost:8000
AUTO_ANNOUNCE=true
ANNOUNCE_RETRY_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10

# Dynamic yt-dlp container configuration
RUNNER_IMAGE=mithril-yt-dlp-runner:latest
DOCKER_NETWORK=mithril-network
INACTIVITY_TIMEOUT_SECONDS=1200
INACTIVITY_CHECK_INTERVAL_SECONDS=30
